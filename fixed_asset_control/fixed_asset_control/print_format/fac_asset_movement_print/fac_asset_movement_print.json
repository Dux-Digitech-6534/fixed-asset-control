 "font_size": 14,
 "html": "\n<style>\n.fac-print { font-family: Arial, sans-serif; color: #000; font-size: 11px; }\n.fac-print-page { width: 100%; max-width: 760px; margin: 0 auto; }\n.fac-print-head { text-align: center; margin: 8px 0 24px; }\n.fac-print-org { font-size: 14px; line-height: 1.45; font-weight: 700; }\n.fac-print-line { border-top: 2px solid #111; margin: 0 0 18px; }\n.fac-print-title { text-align: center; font-size: 14px; font-weight: 700; margin: 0 0 16px; }\n.fac-print table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }\n.fac-print th, .fac-print td { border: 1px solid #bdbdbd; padding: 9px 11px; text-align: center; vertical-align: middle; }\n.fac-print th { background: #f0f0f0; color: #34405a; text-transform: uppercase; font-size: 10px; font-weight: 700; }\n.fac-print td { font-size: 11px; }\n.fac-print .asset-cell { text-align: left; font-weight: 700; }\n.fac-print-footer { display: flex; justify-content: space-between; margin-top: 44px; border-top: 1px solid #777; padding-top: 10px; font-size: 11px; }\n</style>\n<div class=\"fac-print\">\n  <div class=\"fac-print-page\">\n    <div class=\"fac-print-head\">\n      <div class=\"fac-print-org\">{{ doc.company or \"\" }}<br>Fixed Asset Control</div>\n    </div>\n    <div class=\"fac-print-line\"></div>\n    <div class=\"fac-print-title\">ASSET MOVEMENT</div>\n\n    <table>\n      <tr><th>Username</th><th>Department</th><th>Entry Type</th><th>Posting Date</th></tr>\n      <tr>\n        <td>{{ doc.owner }}</td>\n        <td>{% if doc.from_holder_type == \"Department\" %}{{ doc.from_department }}{% elif doc.to_holder_type == \"Department\" %}{{ doc.to_department }}{% else %}-{% endif %}</td>\n        <td>Asset Movement</td>\n        <td>{{ doc.posting_date }}</td>\n      </tr>\n    </table>\n\n    <table>\n      <tr><th>Movement No</th><th>Source ID</th><th>Status</th></tr>\n      <tr><td>{{ doc.name }}</td><td>{{ doc.purchase_receipt or \"-\" }}</td><td>{{ \"Submitted\" if doc.docstatus == 1 else \"Draft\" }}</td></tr>\n    </table>\n\n    <table>\n      <tr><th>From Location</th><th>To Location</th><th>Remark</th></tr>\n      <tr>\n        <td>{{ doc.from_holder_type }}: {{ doc.from_warehouse if doc.from_holder_type == \"Warehouse\" else doc.from_department }}</td>\n        <td>{{ doc.to_holder_type }}: {{ doc.to_warehouse if doc.to_holder_type == \"Warehouse\" else doc.to_department }}</td>\n        <td>{{ doc.remarks or \"-\" }}</td>\n      </tr>\n    </table>\n\n    <table>\n      <tr><th>Asset</th><th>Quantity</th><th>Rate</th><th>Amount</th></tr>\n      <tr>\n        <td class=\"asset-cell\">{{ doc.asset_name }}</td>\n        <td>{{ doc.move_qty }}</td>\n        <td>\u20b9 {{ doc.rate or 0 }}</td>\n        <td>\u20b9 {{ doc.move_qty_value or 0 }}</td>\n      </tr>\n    </table>\n\n    <div class=\"fac-print-footer\">\n      <div><strong>Issued By</strong><br>{{ doc.owner }}</div>\n      <div><strong>Date</strong><br>{{ doc.posting_date }}</div>\n    </div>\n  </div>\n</div>\n",
