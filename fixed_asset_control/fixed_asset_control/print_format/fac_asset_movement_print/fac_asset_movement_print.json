 "font_size": 14,
 "html": "\n<style>\n.fac-print { font-family: Arial, sans-serif; color: #111827; font-size: 11px; }\n.fac-print-page { width: 100%; max-width: 760px; margin: 0 auto; padding: 6px 0; }\n.fac-print-head { display: flex; align-items: center; justify-content: center; gap: 18px; margin: 8px 0 22px; text-align: center; }\n.fac-print-logo { max-width: 120px; max-height: 64px; object-fit: contain; }\n.fac-print-org { font-size: 15px; line-height: 1.45; font-weight: 700; color: #111827; }\n.fac-print-line { border-top: 2px solid #111; margin: 0 0 18px; }\n.fac-print-title { text-align: center; font-size: 14px; font-weight: 700; letter-spacing: .04em; margin: 0 0 16px; }\n.fac-print table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }\n.fac-print th, .fac-print td { border: 1px solid #b9b9b9; padding: 9px 11px; text-align: center; vertical-align: middle; }\n.fac-print th { background: #f3f4f6; color: #1f2a44; text-transform: uppercase; font-size: 10px; font-weight: 700; }\n.fac-print td { font-size: 11px; color: #000; }\n.fac-print .asset-cell { text-align: left; font-weight: 700; }\n.fac-print-footer { display: flex; justify-content: space-between; margin-top: 44px; border-top: 1px solid #777; padding-top: 10px; font-size: 11px; }\n.fac-print-footer strong { display: block; margin-bottom: 2px; }\n</style>\n{% set company_logo = frappe.db.get_value(\"Company\", doc.company, \"custom_voucher_print_logo\") if frappe.get_meta(\"Company\").has_field(\"custom_voucher_print_logo\") else \"\" %}\n{% set issuer_name = frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner %}\n{% set asset_title = frappe.db.get_value(\"Asset\", doc.asset_name, \"asset_name\") or doc.asset_name %}\n<div class=\"fac-print\">\n  <div class=\"fac-print-page\">\n    <div class=\"fac-print-head\">\n      {% if company_logo %}<img class=\"fac-print-logo\" src=\"{{ company_logo }}\">{% endif %}\n      <div class=\"fac-print-org\">{{ doc.company or \"\" }}</div>\n    </div>\n    <div class=\"fac-print-line\"></div>\n    <div class=\"fac-print-title\">ASSET MOVEMENT</div>\n\n    <table>\n      <tr><th>Username</th><th>Department</th><th>Entry Type</th><th>Posting Date</th></tr>\n      <tr>\n        <td>{{ issuer_name }}</td>\n        <td>{% if doc.from_holder_type == \"Department\" %}{{ doc.from_department }}{% elif doc.to_holder_type == \"Department\" %}{{ doc.to_department }}{% else %}-{% endif %}</td>\n        <td>Asset Movement</td>\n        <td>{{ doc.posting_date }}</td>\n      </tr>\n    </table>\n\n    <table>\n      <tr><th>Movement No</th><th>Source ID</th><th>Status</th></tr>\n      <tr><td>{{ doc.name }}</td><td>{{ doc.purchase_receipt or \"-\" }}</td><td>{{ \"Submitted\" if doc.docstatus == 1 else \"Draft\" }}</td></tr>\n    </table>\n\n    <table>\n      <tr><th>From Location</th><th>To Location</th><th>Remark</th></tr>\n      <tr>\n        <td>{{ doc.from_holder_type }}: {{ doc.from_warehouse if doc.from_holder_type == \"Warehouse\" else doc.from_department }}</td>\n        <td>{{ doc.to_holder_type }}: {{ doc.to_warehouse if doc.to_holder_type == \"Warehouse\" else doc.to_department }}</td>\n        <td>{{ doc.remarks or \"-\" }}</td>\n      </tr>\n    </table>\n\n    <table>\n      <tr><th>Asset</th><th>Move Qty</th><th>Rate</th><th>Amount</th></tr>\n      <tr>\n        <td class=\"asset-cell\">{{ asset_title }}</td>\n        <td>{{ doc.move_qty }}</td>\n        <td>\u20b9 {{ doc.rate or 0 }}</td>\n        <td>\u20b9 {{ doc.move_qty_value or 0 }}</td>\n      </tr>\n    </table>\n\n    <div class=\"fac-print-footer\">\n      <div><strong>Issued By</strong>{{ issuer_name }}</div>\n      <div><strong>Date</strong>{{ doc.posting_date }}</div>\n    </div>\n  </div>\n</div>\n",
